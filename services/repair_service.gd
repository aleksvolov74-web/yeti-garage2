class_name RepairService
extends RefCounted

# Пошаговые ремонтные сценарии. В этой версии сознательно не храним
# неподтверждённые размеры инструмента и моменты затяжки: такие данные будут
# добавляться только после проверки для конкретной модификации Yeti.

static func guide_for_part(part_id: String) -> Dictionary:
    match part_id:
        "brake_pads":
            return _front_brake_pads()
        _:
            return {}

static func get_guide(guide_id: String) -> Dictionary:
    match guide_id:
        "front_brake_pads_replace":
            return _front_brake_pads()
        _:
            return {}

static func start_session(guide_id: String, part_id: String) -> Dictionary:
    var existing := active_session()
    if str(existing.get("guide_id", "")) == guide_id:
        return existing
    var session := {
        "guide_id": guide_id,
        "part_id": part_id,
        "step": 0,
        "started_at": int(Time.get_unix_time_from_system()),
        "updated_at": int(Time.get_unix_time_from_system())
    }
    Storage.data["active_repair_session"] = session
    Storage.save()
    return session

static func active_session() -> Dictionary:
    var value = Storage.data.get("active_repair_session", {})
    return value if typeof(value) == TYPE_DICTIONARY else {}

static func set_step(step: int) -> void:
    var session := active_session()
    if session.is_empty():
        return
    session["step"] = maxi(step, 0)
    session["updated_at"] = int(Time.get_unix_time_from_system())
    Storage.data["active_repair_session"] = session
    Storage.save()

static func clear_session() -> void:
    Storage.data["active_repair_session"] = {}
    Storage.save()

