class_name DiagnosticService
extends RefCounted

# Небольшая проверенная логика для первого прототипа диагностики.
# Это не «автоматический диагноз», а дерево проверок: симптом -> уточнение -> следующая проверка.
# Позже эти сценарии переедут в отдельную базу и будут привязаны к точным узлам/3D.

static func scenarios() -> Array:
    return [
        {"id":"engine_misfire", "title":"Двигатель троит / дёргается", "subtitle":"Вибрация, неровная работа, потеря тяги", "keywords":["троит", "дергается", "дёргается", "вибрация", "пропуски", "check engine", "чек", "потеря тяги"]},
        {"id":"no_start", "title":"Машина не заводится", "subtitle":"Стартер не крутит или двигатель не запускается", "keywords":["не заводится", "не запускается", "стартер", "щелкает", "щёлкает", "аккумулятор", "иммобилайзер"]},
        {"id":"turn_click", "title":"Хруст при повороте", "subtitle":"Щелчки или хруст спереди при вывороте руля", "keywords":["хруст", "щелчки", "поворот", "выворот", "шрус", "граната"]},
        {"id":"road_hum", "title":"Гул при движении", "subtitle":"Шум растёт вместе со скоростью", "keywords":["гул", "гудит", "шум", "скорость", "ступичный", "подшипник"]},
        {"id":"brake_issue", "title":"Проблема с тормозами", "subtitle":"Скрип, биение, увод или слабое торможение", "keywords":["тормоза", "скрип", "биение", "увод", "плохо тормозит", "греется колесо"]},
        {"id":"suspension_knock", "title":"Стук в подвеске", "subtitle":"Стук или щелчки на неровностях", "keywords":["стук спереди", "стук подвески", "подвеска", "неровности", "ямы", "щелчки"]},
        {"id":"steering_play", "title":"Люфт / стук в рулевом", "subtitle":"Руль реагирует с задержкой или есть стук", "keywords":["люфт руля", "стук рулевого", "рулевое", "задержка руля", "наконечник"]},
        {"id":"coolant_loss", "title":"Уходит антифриз", "subtitle":"Падает уровень, лужа, запах или перегрев", "keywords":["антифриз", "охлаждающая жидкость", "ож", "перегрев", "лужа", "запах", "уровень падает"]}
    ]

static func search(query: String) -> Array:
    var q := _normalize_search(query)
    if q == "":
        return []
    var tokens := q.split(" ", false)
    var scored: Array = []
    for scenario_value in scenarios():
        var scenario: Dictionary = scenario_value
        var title := _normalize_search(str(scenario.get("title", "")))
        var subtitle := _normalize_search(str(scenario.get("subtitle", "")))
        var haystack := title + " " + subtitle
        for keyword_value in scenario.get("keywords", []):
            haystack += " " + _normalize_search(str(keyword_value))
        var score := 0
        if title.contains(q):
            score += 80
        elif haystack.contains(q):
            score += 55
        for token_value in tokens:
            var token := str(token_value)
            if token.length() < 3:
                continue
            if title.contains(token):
                score += 18
            elif haystack.contains(token):
                score += 8
        if score > 0:
            var row := scenario.duplicate(true)
            row["score"] = score
            scored.append(row)
    scored.sort_custom(func(a, b):
        var sa := int(a.get("score", 0))
        var sb := int(b.get("score", 0))
        if sa == sb:
            return str(a.get("title", "")) < str(b.get("title", ""))
        return sa > sb
    )
    return scored

static func _normalize_search(value: String) -> String:
    var result := value.strip_edges().to_lower().replace("ё", "е")
    var separators := [".", ",", ";", ":", "!", "?", "(", ")", "[", "]", "{", "}", "\"", "'", "«", "»", "/", "\\", "-", "—", "–", "\n", "\r", "\t"]
    for separator_value in separators:
        result = result.replace(str(separator_value), " ")
    while result.contains("  "):
        result = result.replace("  ", " ")
    return result.strip_edges()

static func flow(flow_id: String) -> Dictionary:
    match flow_id:
        "engine_misfire":
            return _engine_misfire()
        "no_start":
            return _no_start()
        "turn_click":
            return _turn_click()
        "road_hum":
            return _road_hum()
        "brake_issue":
            return _brake_issue()
        "suspension_knock":
            return _suspension_knock()
        "steering_play":
            return _steering_play()
        "coolant_loss":
            return _coolant_loss()
        _:
            return {}

